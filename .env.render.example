# ============================================
# Render Deployment Environment Variables
# ============================================
# This is a template for production deployment on Render
# Copy this to .env.render in the prod branch only
# Replace values with your actual Supabase pooler credentials

# PostgreSQL Database (Supabase pooler)
# Use the pooler host from Supabase Project Settings > Database > Connect.
# Session pooler is safest for this Spring/JPA backend because it keeps
# connection/session behavior compatible with Hibernate/JDBC prepared statements.
POSTGRES_DB=postgres
POSTGRES_USER=postgres.your-project-ref
POSTGRES_PASSWORD=your-supabase-database-password

# Database Connection (Supabase pooler)
# Session pooler example:
DB_URL=jdbc:postgresql://aws-0-your-region.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-supabase-database-password
SPRING_FLYWAY_ENABLED=true
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5

# JWT Configuration
JWT_SECRET=replace-with-a-random-32-byte-base64-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
JWT_ISSUER=hotelhub-admin

# Security Settings (Production)
SECURE_COOKIES=true
COOKIE_SAME_SITE=None
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example.com,capacitor://localhost,http://localhost

# Admin Bootstrap (Change these for production!)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password
BOOTSTRAP_ADMIN_FULL_NAME=Hotel Admin
BOOTSTRAP_SAMPLE_DATA=false

# Frontend API Base URL (Production)
VITE_API_BASE_URL=https://api.hotelhub.example.com
