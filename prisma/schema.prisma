generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String         @unique @db.VarChar(255)
  fullName      String         @map("fullName") @db.VarChar(120)
  passwordHash  String         @map("password_hash") @db.VarChar(255)
  role          String         @db.VarChar(30)
  active        Boolean        @default(true)
  lastLoginAt   DateTime?      @map("last_login_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  refreshTokens RefreshToken[]

  @@map("admin_users")
}

model Room {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomNumber    String         @unique @map("room_number") @db.VarChar(50)
  roomType      String         @map("room_type") @db.VarChar(80)
  floorNumber   Int            @map("floor_number")
  maxOccupancy  Int            @map("max_occupancy")
  status        String         @db.VarChar(30)
  roomRent      Decimal        @map("room_rent") @db.Decimal(12, 2)
  notes         String?        @db.VarChar(1200)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  revenueEntries RevenueEntry[]
  expenses      Expense[]

  @@map("rooms")
}

model RevenueEntry {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId         String    @map("room_id") @db.Uuid
  bookingGroupId String    @map("booking_group_id") @db.Uuid
  checkInDate    DateTime  @map("check_in_date") @db.Date
  checkInTime    DateTime  @map("check_in_time") @db.Time
  chargeFromDate DateTime  @map("charge_from_date") @db.Date
  rentUntilDate  DateTime  @map("rent_until_date") @db.Date
  checkoutDate   DateTime? @map("checkout_date") @db.Date
  checkoutTime   DateTime? @map("checkout_time") @db.Time
  guestName      String    @map("guest_name") @db.VarChar(120)
  mobileNumber   String    @map("mobile_number") @db.VarChar(30)
  address        String    @map("address") @db.VarChar(1200)
  aadharNumber   String    @map("aadhar_number") @db.VarChar(30)
  purposeOfStay  String    @map("purpose_of_stay") @db.VarChar(255)
  roomRent       Decimal   @map("room_rent") @db.Decimal(12, 2)
  rentEditReason String?   @map("rent_edit_reason") @db.VarChar(500)
  rentDays       Int       @map("rent_days")
  checkingOut    Boolean   @map("checking_out")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  room           Room      @relation(fields: [roomId], references: [id])

  @@index([checkInDate], map: "idx_revenue_entries_check_in_date")
  @@index([bookingGroupId], map: "idx_revenue_entries_booking_group_id")
  @@index([roomId], map: "idx_revenue_entries_room_id")
  @@map("revenue_entries")
}

model Expense {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId      String?  @map("room_id") @db.Uuid
  expenseDate DateTime @map("expense_date") @db.Date
  category    String   @db.VarChar(30)
  vendorName  String   @map("vendor_name") @db.VarChar(120)
  amount      Decimal  @db.Decimal(12, 2)
  notes       String?  @db.VarChar(1200)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  room        Room?    @relation(fields: [roomId], references: [id])

  @@index([expenseDate], map: "idx_expenses_expense_date")
  @@index([roomId], map: "idx_expenses_room_id")
  @@map("expenses")
}

model RefreshToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipAddress   String?   @map("ip_address") @db.VarChar(255)
  userAgent   String?   @map("user_agent") @db.VarChar(512)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId], map: "idx_refresh_tokens_admin_user_id")
  @@index([expiresAt], map: "idx_refresh_tokens_expires_at")
  @@map("refresh_tokens")
}
